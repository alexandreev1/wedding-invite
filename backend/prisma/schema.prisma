generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Invitation {
  id      String  @id @default(uuid())
  token   String  @unique
  isRSVP  Boolean @default(false)
  guests  Guest[]
}

model Guest {
  id           String     @id @default(uuid())
  name         String
  gender       String
  avatarUrl    String
  tableId      Int?
  seatNumber   Int?
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  invitationId String
}
